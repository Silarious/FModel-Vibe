<adonisControls:AdonisWindow x:Class="FModel.Views.SettingsView"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:local="clr-namespace:FModel"
                             xmlns:c4pMeshes="clr-namespace:CUE4Parse_Conversion.Meshes;assembly=CUE4Parse-Conversion"
                             xmlns:controls="clr-namespace:FModel.Views.Resources.Controls"
                             xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
                             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                             WindowStartupLocation="CenterScreen" ResizeMode="NoResize" IconVisibility="Collapsed" SizeToContent="Height"
                             MinHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.10'}"
                             Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.45'}"
                             AllowDrop="True">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}" >
            <Setter Property="Title" Value="Settings" />
        </Style>
    </adonisControls:AdonisWindow.Style>
    <adonisControls:AdonisWindow.Resources>
        <ResourceDictionary>
            <controls:OnTagDataTemplateSelector x:Key="TagTemplateSelector" />
            <DataTemplate x:Key="GeneralTemplate">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}, Converter={converters:RatioConverter}, ConverterParameter='0.72'}"
                              adonisExtensions:ScrollViewerExtension.VerticalScrollBarExpansionMode="NeverExpand"
                              adonisExtensions:ScrollViewerExtension.VerticalScrollBarPlacement="Docked">
                <Grid adonisExtensions:LayerExtension.Layer="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Output Directory *" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Directory where log files, backups and other do-not-delete files will be put in." />
                    <TextBox x:Name="ImJackedBro" Grid.Row="0" Grid.Column="2" IsReadOnly="True" Text="{Binding OutputDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="0" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseOutput" Margin="0 0 0 5" />

                    <CheckBox Grid.Row="0" Grid.Column="6" Margin="5 0 0 5" ToolTip="Customize the directory of more output folders"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                              IsChecked="{Binding SettingsView.UseCustomOutputFolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" HorizontalAlignment="Stretch"
                          DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                          Visibility="{Binding SettingsView.UseCustomOutputFolders, Converter={StaticResource BoolToVisibilityConverter}}"
                          Grid.IsSharedSizeScope="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" SharedSizeGroup="SettingsPathColumn" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Export Raw Data Directory *" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" FontStyle="Italic" Margin="0 0 0 5" />
                        <TextBox Grid.Row="0" Grid.Column="2" IsReadOnly="True" Text="{Binding RawDataDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Margin="0 0 0 5" />
                        <Button Grid.Row="0" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseRawData" Margin="0 0 0 5" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Save Properties Directory *" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" FontStyle="Italic" Margin="0 0 0 5" />
                        <TextBox Grid.Row="1" Grid.Column="2" IsReadOnly="True" Text="{Binding PropertiesDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Margin="0 0 0 5" />
                        <Button Grid.Row="1" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseProperties" Margin="0 0 0 5" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Save Texture Directory *" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" FontStyle="Italic" Margin="0 0 0 5" />
                        <TextBox Grid.Row="2" Grid.Column="2" IsReadOnly="True" Text="{Binding TextureDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Margin="0 0 0 5" />
                        <Button Grid.Row="2" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseTexture" Margin="0 0 0 5" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Save Audio Directory *" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" FontStyle="Italic" Margin="0 0 0 5" />
                        <TextBox Grid.Row="3" Grid.Column="2" IsReadOnly="True" Text="{Binding AudioDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" Margin="0 0 0 5" />
                        <Button Grid.Row="3" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseAudio" Margin="0 0 0 5" />
                    </Grid>

                    <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource CustomSeparator}" Tag="GAME"></Separator>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Archive Directory *" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" IsReadOnly="True" Text="{Binding GameDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="4" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnBrowseDirectories" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="UE Versions *" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Override the UE version to use when parsing packages" />
                    <controls:FilterableComboBox Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="5" SelectedItem="{Binding SettingsView.SelectedUeGame, Mode=TwoWay}"
                                                 ItemsSource="{Binding SettingsView.UeGames}"
                                                 Style="{StaticResource UComboBox}"
                                                 DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                                                 Margin="0 0 0 5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </controls:FilterableComboBox>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Texture Platform *" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Override the game's platform to ensure texture compatibility" />
                    <ComboBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="5" ItemsSource="{Binding SettingsView.Platforms}" SelectedItem="{Binding SettingsView.SelectedUePlatform, Mode=TwoWay}"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                              Margin="0 0 0 5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Compressed Audio" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="What to do when encountering a compressed audio file" />
                    <ComboBox Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="5" ItemsSource="{Binding SettingsView.CompressedAudios}" SelectedItem="{Binding SettingsView.SelectedCompressedAudio, Mode=TwoWay}"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}" Margin="0 0 0 5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Packages Language" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Language used and shown when parsing packages" />
                    <ComboBox Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="5" ItemsSource="{Binding SettingsView.AssetLanguages}" SelectedItem="{Binding SettingsView.SelectedAssetLanguage, Mode=TwoWay}"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}" Margin="0 0 0 5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Keep Directory Structure" VerticalAlignment="Center" Margin="0 5 0 10" ToolTip="Auto-save packages following their game directory" />
                    <CheckBox Grid.Row="9" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                              IsChecked="{Binding KeepDirectoryStructure, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                              Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Local Mapping File (drag &amp; drop)" VerticalAlignment="Center" Margin="0 5 0 0" />
                    <CheckBox Grid.Row="10" Grid.Column="2" Margin="0 5 0 0"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                              Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                              IsChecked="{Binding SettingsView.MappingEndpoint.Overwrite, Mode=TwoWay}"
                              Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="Mapping File Path" VerticalAlignment="Center" Margin="0 10 0 0"
                               DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                               Visibility="{Binding SettingsView.MappingEndpoint.Overwrite, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="3" Margin="0 10 0 0" Text="{Binding SettingsView.MappingEndpoint.FilePath, Mode=TwoWay}"
                             DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                             Visibility="{Binding SettingsView.MappingEndpoint.Overwrite, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Grid.Row="11" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnBrowseMappings" Margin="0 10 0 0"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                            Visibility="{Binding SettingsView.MappingEndpoint.Overwrite, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Expander Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="7" ExpandDirection="Down"
                              IsExpanded="{Binding SettingsAdvancedExpanded, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                              Style="{StaticResource SeparatorExpander}" Header="ADVANCED">
                        <Grid Margin="0 4 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Versioning Configuration *" VerticalAlignment="Center" Margin="0 0 0 5" />
                            <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="5" Margin="0 0 0 5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Custom Versions" Click="OpenCustomVersions" />
                                <Button Grid.Column="2" Content="Options" Click="OpenOptions" />
                                <Button Grid.Column="4" Content="MapStructTypes" Click="OpenMapStructTypes" />
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="AES Reload at Launch" VerticalAlignment="Center" Margin="0 0 0 5"
                                       DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                                       Visibility="{Binding SettingsView.AesEndpoint.IsValid, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ComboBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" Margin="0 0 0 5"
                                      DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}"
                                      ItemsSource="{Binding SettingsView.AesReloads}" SelectedItem="{Binding SettingsView.SelectedAesReload, Mode=TwoWay}"
                                      Visibility="{Binding SettingsView.AesEndpoint.IsValid, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Endpoint Configuration" VerticalAlignment="Center" Margin="0 0 0 5" />
                            <Grid Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5" Margin="0 0 0 5"
                                  DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="AES" Click="OpenAesEndpoint" />
                                <Button Grid.Column="2" Content="Mapping" Click="OpenMappingEndpoint" />
                            </Grid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Serialize Script Bytecode" VerticalAlignment="Center" Margin="0 0 0 5" />
                            <CheckBox Grid.Row="3" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ReadScriptData, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Serialize Inlined Shader Maps" VerticalAlignment="Center" Margin="0 0 0 5" />
                            <CheckBox Grid.Row="4" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ReadShaderMaps, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Decompile Blueprint to Pseudo C++" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Adds a right click option to decompile UClass packages into a pseudo C++ friendly format" />
                            <CheckBox Grid.Row="5" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ShowDecompileOption, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Decompile Lua" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Decompile/Disassemble compiled lua files with an unluac." />
                            <CheckBox Grid.Row="6" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding DecompileLua, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}"
                                      Checked="OnDecompileLuaChanged" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Convert Audio During Export (.wav)" VerticalAlignment="Center" Margin="0 0 0 5" />
                            <CheckBox Grid.Row="7" Grid.Column="2"
                                      Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ConvertAudioOnBulkExport, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                                      Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="CRIWARE Decryption Key" VerticalAlignment="Center" Margin="0 0 0 10" />
                            <TextBox x:Name="CriwareKeyBox"
                                     Grid.Row="8"
                                     Grid.Column="2"
                                     Grid.ColumnSpan="5"
                                     Margin="0 5 0 10"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     MaxLength="20"
                                     ToolTip="Enter decryption key in numeric or hexadecimal format (valid key is up to 20 digits or 8 bytes long)"
                                     TextAlignment="Right"
                                     TextChanged="CriwareKeyBox_TextChanged"
                                     Loaded="CriwareKeyBox_Loaded"/>
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="7" ExpandDirection="Down"
                              IsExpanded="{Binding SettingsExportBehaviorExpanded, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                              Style="{StaticResource SeparatorExpander}" Header="EXPORT BEHAVIOR">
                        <Grid Margin="0 4 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Metadata Export" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Disabled: never export metadata automatically. Auto Export: save metadata to its own file alongside the properties json. Append to Json: merge the metadata into the properties json file itself to avoid an extra file." />
                            <ComboBox Grid.Row="0" Grid.Column="2" Margin="0 0 0 5"
                                      ItemsSource="{Binding SettingsView.MetadataExportModes}" SelectedItem="{Binding SettingsView.SelectedMetadataExportMode, Mode=TwoWay}"
                                      DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Skip Already Exported Files" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Don't redo work: if the destination file already exists (and, in the Name and Size mode, isn't empty), skip it instead of overwriting it. Both modes only ever check the filesystem, never reprocess the asset, so they're cheap and checked as early as possible." />
                            <ComboBox Grid.Row="1" Grid.Column="2" Margin="0 0 0 5"
                                      ItemsSource="{x:Static local:Settings.UserSettings.SkipAlreadyExportedModes}"
                                      SelectedItem="{Binding SkipAlreadyExportedMode, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Overwrite Protection" VerticalAlignment="Center" Margin="0 5 0 10"
                                       ToolTip="Only relevant while Skip Already Exported Files is Disabled. Refuses to overwrite a destination file that already exists with a different size than the new export - a safety net against clobbering files from a different game version/build (e.g. output directories set up wrong), instead of silently overwriting them." />
                            <CheckBox Grid.Row="2" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding OverwriteProtection, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Export Smallest Files First" VerticalAlignment="Center" Margin="0 5 0 10" ToolTip="When bulk exporting a folder, process smaller files before bigger ones" />
                            <CheckBox Grid.Row="3" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ExportSmallestFilesFirst, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Group Export Loose Assets" VerticalAlignment="Center" Margin="0 5 0 10"
                                       ToolTip="When enabled: loose images (png/jpg/bmp/svg) save with Texture export; text/config/font files (ini, txt, json, ttf/otf/ufont, …) save with Properties export. When disabled, fonts only export via Raw Data (legacy)." />
                            <CheckBox Grid.Row="4" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding GroupExportLooseAssets, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Auto Export Textures with Models" VerticalAlignment="Center" Margin="0 5 0 10" ToolTip="When bulk exporting a folder of models, also export any textures found in it" />
                            <CheckBox Grid.Row="5" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding AutoExportTexturesWithModels, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Auto Load All Files on Startup" VerticalAlignment="Center" Margin="0 5 0 10" ToolTip="Once pak/archive files are recognized, automatically populate the assets explorer with everything (equivalent to pressing Load with the All mode)" />
                            <CheckBox Grid.Row="6" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding AutoLoadAllFilesOnStartup, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Convert uint64 to Float" VerticalAlignment="Center" Margin="0 5 0 10" ToolTip="When saving properties/json, detect integers that are actually a bit-cast double (an 8-byte float stored as a uint64) and replace them with the readable float value" />
                            <CheckBox Grid.Row="7" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding ConvertUint64ToFloat, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 5 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="7" ExpandDirection="Down"
                              IsExpanded="{Binding SettingsMultiThreadingExpanded, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                              Style="{StaticResource SeparatorExpander}" Header="MULTI THREADING &amp; LIMITS"
                              ToolTip="Parallelism and memory limits for bulk export / Export Queue">
                        <Grid Margin="0 4 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Use Concurrent Workers" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="When enabled, folder / Export Queue exports run with Export Max Concurrent Workers. When disabled, exports use a single worker (degree of parallelism = 1)." />
                            <CheckBox Grid.Row="0" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 0 0 5"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Export Max Concurrent Workers" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Max concurrent workers for folder / Export Queue exports. 0 = auto (usable cores = CPU count − Reserved CPU Threads). Set explicitly (e.g. 8) to override. Ignored when Use Concurrent Workers is disabled. This is degree of parallelism, not which cores are used."
                                       IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />
                            <TextBox Grid.Row="1" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding ExportMaxThreads, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}"
                                     IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Add Workers for Image/Models" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Additional workers added to Export Max Concurrent Workers for texture/image or model exports (when Textures or Meshes is enabled, including All Assets). 0 = none; +1 to +16. Final DOP is still capped at usable cores (CPU count − Reserved CPU Threads). Ignored when Use Concurrent Workers is disabled."
                                       IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />
                            <TextBox Grid.Row="2" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding ImageExportWorkerBias, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}"
                                     IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Large File Workers (&gt;10MB)" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Max concurrent workers for packages larger than 10MB and at most 100MB (default 2, range 1–32). Still capped by Export Max Concurrent Workers. Ignored when Use Concurrent Workers is disabled."
                                       IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />
                            <TextBox Grid.Row="3" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding LargeFileExportWorkers, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}"
                                     IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Huge File Workers (&gt;100MB)" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Max concurrent workers for packages larger than 100MB (default 1, range 1–32). Still capped by Export Max Concurrent Workers. Ignored when Use Concurrent Workers is disabled."
                                       IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />
                            <TextBox Grid.Row="4" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding HugeFileExportWorkers, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}"
                                     IsEnabled="{Binding UseConcurrentWorkers, Source={x:Static local:Settings.UserSettings.Default}}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Reserved CPU Threads" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Logical CPU threads (hyperthreads) excluded from FModel via process affinity (0–4, default 2). FModel cannot schedule on those CPUs — distinct from Export Max Concurrent Workers. 0 disables. Verify: Task Manager → Details → FModel_Vibe.exe → Set affinity (highest N CPUs unchecked). Performance graphs can still light up from other apps." />
                            <TextBox Grid.Row="5" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding ReservedCpuCores, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Enable Memory Guard" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Prevent FModel from consuming all system RAM during bulk export. Soft target throttles new workers; hard cap stops new work to protect the OS. Does not kill the process." />
                            <CheckBox Grid.Row="6" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding EnableMemoryGuard, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 0 0 5"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Memory Soft Target %" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Soft target as % of total physical RAM (default 55). When process working set exceeds this, export workers pause taking new packages until memory drops below target − 5%. Throttle only — does not stop in-flight packages." />
                            <TextBox Grid.Row="7" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding MemorySoftTargetPercent, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}" />

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Memory Hard Cap %" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Hard cap as % of total physical RAM (default 85). When hit (or system available RAM is critically low), stop issuing new export work immediately and reduce concurrency to 0–1 until back under the soft resume band. Protects the OS from soft-lock; prefer stalling over killing FModel." />
                            <TextBox Grid.Row="8" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding MemoryHardCapPercent, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Export Perf Log" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="When enabled, writes Logs/FModel-ExportPerf-*.log for bulk/queue exports. Lists slow exports scored by ms per MB (small slow files rank highest) plus a large-file (≥10MB) comparison section. Includes Working Set / Private / GC deltas." />
                            <CheckBox Grid.Row="9" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding EnableExportPerfLog, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 0 0 5"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Perf Log Min Duration (ms)" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Only record exports that take at least this many milliseconds (default 250). Ignored when Export Perf Log is disabled."
                                       IsEnabled="{Binding EnableExportPerfLog, Source={x:Static local:Settings.UserSettings.Default}}" />
                            <TextBox Grid.Row="10" Grid.Column="2" Width="80" HorizontalAlignment="Left" Margin="0 0 0 5"
                                     Text="{Binding ExportPerfLogMinMs, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={x:Static converters:SafeIntConverter.Instance}}"
                                     IsEnabled="{Binding EnableExportPerfLog, Source={x:Static local:Settings.UserSettings.Default}}" />
                        </Grid>
                    </Expander>

                    <Expander Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="7" ExpandDirection="Down"
                              IsExpanded="{Binding SettingsFortniteLiveExpanded, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                              Style="{StaticResource SeparatorExpander}" Header="FORTNITE LIVE"
                              ToolTip="Options that only apply when using the Fortnite LIVE profile / fortnite-live.manifest">
                        <Grid Margin="0 4 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Auto Load on Startup" VerticalAlignment="Center" Margin="0 0 0 10"
                                       ToolTip="When using the Fortnite LIVE profile, download/register CDN archives on launch. Off by default — use Directory → Load Fortnite LIVE… instead." />
                            <CheckBox Grid.Row="0" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding AutoLoadFortniteLiveOnStartup, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 0 0 10"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Include UEFN" VerticalAlignment="Center" Margin="0 0 0 5"
                                       ToolTip="Also register Fortnite Creative/UEFN archives when using fortnite-live.manifest. Off by default — roughly doubles LIVE startup time." />
                            <CheckBox Grid.Row="1" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                      IsChecked="{Binding FortniteLiveIncludeUefn, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}" Margin="0 0 0 5"
                                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />
                        </Grid>
                    </Expander>

                </Grid>
                </ScrollViewer>
            </DataTemplate>
            <DataTemplate x:Key="ProfilesTemplate">
                <Grid adonisExtensions:LayerExtension.Layer="2"
                      DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Profiles" VerticalAlignment="Top" Margin="0 0 0 5"
                               ToolTip="Selecting a profile previews its settings below. Load applies that profile (restarts). Save writes the fields below into the selected profile." />
                    <ListBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="5" MaxHeight="120" Margin="0 0 0 5"
                             ItemsSource="{Binding ProfilesView.ProfileNames}" SelectedItem="{Binding ProfilesView.SelectedProfile, Mode=TwoWay}" />

                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Margin="0 0 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ProfilesView.StatusText}" VerticalAlignment="Center" FontStyle="Italic" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="Load" Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}"
                                IsEnabled="{Binding ProfilesView.CanLoad}" Click="OnProfileLoad"
                                ToolTip="Apply the selected profile to live settings and restart FModel" />
                        <Button Grid.Column="4" Content="Delete" Click="OnProfileDelete"
                                IsEnabled="{Binding ProfilesView.SelectedProfile, Converter={x:Static converters:IsNullToBoolReversedConverter.Instance}}" />
                        <Button Grid.Column="6" Content="Save As" Click="OnProfileSaveAs" />
                        <Button Grid.Column="8" Content="Rename" Click="OnProfileRename"
                                IsEnabled="{Binding ProfilesView.SelectedProfile, Converter={x:Static converters:IsNullToBoolReversedConverter.Instance}}" />
                        <Button Grid.Column="10" Content="Save" Click="OnProfileSave"
                                ToolTip="Write the fields below into the selected profile" />
                    </Grid>

                    <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource CustomSeparator}" Tag="PER FILE TYPE DIRECTORIES"></Separator>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Raw Data Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.RawDataDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="3" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseRawData" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Properties Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.PropertiesDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="4" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseProperties" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Texture Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.TextureDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="5" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseTexture" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Audio Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.AudioDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="6" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseAudio" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Model Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.ModelDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="7" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseModels" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Code Directory" VerticalAlignment="Center" Margin="0 0 0 5" />
                    <TextBox Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.CodeDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="8" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseCode" Margin="0 0 0 5" />

                    <Separator Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="7" Style="{StaticResource CustomSeparator}" Tag="GAME"></Separator>

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Pak Archive" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="The game's install/archive directory FModel loads paks from" />
                    <TextBox Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.GameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="10" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseDirectories" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Text="UE Version" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Override the UE version to use when parsing packages for this game" />
                    <controls:FilterableComboBox Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="5" Margin="0 0 0 5"
                                                 ItemsSource="{Binding SettingsView.UeGames}"
                                                 Style="{StaticResource UComboBox}"
                                                 SelectedItem="{Binding ProfilesView.Preview.UeVersion, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </controls:FilterableComboBox>

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Mapping File (.usmap)" VerticalAlignment="Center" Margin="0 0 0 5"
                               ToolTip="Selecting or entering a mapping file enables local mapping override automatically" />
                    <TextBox Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="3" Text="{Binding ProfilesView.Preview.MappingFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="12" Grid.Column="6" Content="..." HorizontalAlignment="Right" Click="OnProfileBrowseMappings" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="13" Grid.Column="0" Text="AES Key" VerticalAlignment="Center" Margin="0 0 0 5" ToolTip="Main AES decryption key for this profile. For dynamic keys or bulk management, use the AES Manager instead." />
                    <TextBox Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="5" Text="{Binding ProfilesView.Preview.AesMainKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />

                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CreatorTemplate">
                <Grid adonisExtensions:LayerExtension.Layer="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Grid.ColumnSpan="3" DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="pack://application:,,,/Resources/T_Placeholder_Item_Image.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsView.SelectedCosmeticStyle}" Value="{x:Static local:EIconStyle.Default}">
                                        <Setter Property="Source" Value="pack://application:,,,/Resources/Default.png"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettingsView.SelectedCosmeticStyle}" Value="{x:Static local:EIconStyle.NoBackground}">
                                        <Setter Property="Source" Value="pack://application:,,,/Resources/NoBackground.png"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettingsView.SelectedCosmeticStyle}" Value="{x:Static local:EIconStyle.NoText}">
                                        <Setter Property="Source" Value="pack://application:,,,/Resources/NoText.png"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettingsView.SelectedCosmeticStyle}" Value="{x:Static local:EIconStyle.Flat}">
                                        <Setter Property="Source" Value="pack://application:,,,/Resources/Flat.png"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SettingsView.SelectedCosmeticStyle}" Value="{x:Static local:EIconStyle.Cataba}">
                                        <Setter Property="Source" Value="pack://application:,,,/Resources/Cataba.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Grid Grid.Column="3" Grid.ColumnSpan="5" Margin="10 0 0 0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cosmetic Style" VerticalAlignment="Center" Margin="0 0 0 5" />
                        <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding SettingsView.CosmeticStyles}" SelectedItem="{Binding SettingsView.SelectedCosmeticStyle, Mode=TwoWay}"
                                  DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}" Margin="0 0 0 5">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cosmetic Shop Icon" VerticalAlignment="Center" Margin="0 0 0 5" />
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                                  IsChecked="{Binding CosmeticDisplayAsset, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay}"
                                  Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" Margin="0 5 0 10"/>
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ModelsTemplate">
                <Grid adonisExtensions:LayerExtension.Layer="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Model Export Directory *" VerticalAlignment="Center" Margin="0 0 0 5"
                               ToolTip="This will be the directory where Meshes, Materials and Animations will be exported" />
                    <TextBox Grid.Row="0" Grid.Column="2" IsReadOnly="True" Text="{Binding ModelDirectory, Source={x:Static local:Settings.UserSettings.Default}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 5" />
                    <Button Grid.Row="0" Grid.Column="4" Content="..." HorizontalAlignment="Right" Click="OnBrowseModels" Margin="0 0 0 5" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mesh Format" VerticalAlignment="Center" Margin="0 0 0 5"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" ItemsSource="{Binding SettingsView.MeshExportFormats}" SelectedItem="{Binding SettingsView.SelectedMeshExportFormat, Mode=TwoWay}"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}" Margin="0 0 0 5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static converters:EnumToStringConverter.Instance}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ContentControl Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" FontSize="10" Margin="0 0 0 5">
                        <ContentControl.Style>
                            <Style TargetType="{x:Type ContentControl}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <EventSetter Event="Hyperlink.Click" Handler="OnHyperlinkClick" />

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SettingsView.SelectedMeshExportFormat, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:Views.SettingsView}}}" Value="{x:Static c4pMeshes:EMeshFormat.UEFormat}">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="Importer (Blender/UE): " />
                                                        <Hyperlink NavigateUri="https://github.com/h4lfheart/UEFormat">
                                                            github.com/h4lfheart/UEFormat
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Visibility" Value="Visible" />
