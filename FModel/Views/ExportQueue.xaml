<adonisControls:AdonisWindow x:Class="FModel.Views.ExportQueue"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:converters="clr-namespace:FModel.Views.Resources.Converters"
         xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
         xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
         xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
         WindowStartupLocation="CenterScreen" ResizeMode="NoResize" IconVisibility="Collapsed" SizeToContent="Height"
         Width="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}, Converter={converters:RatioConverter}, ConverterParameter='0.3'}">
    <adonisControls:AdonisWindow.Style>
        <Style TargetType="adonisControls:AdonisWindow" BasedOn="{StaticResource {x:Type adonisControls:AdonisWindow}}" >
            <Setter Property="Title" Value="Export Queue" />
        </Style>
    </adonisControls:AdonisWindow.Style>
    <Grid Column="2" adonisExtensions:LayerExtension.Layer="2" Margin="10" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Text="Turn Queuing Mode on, then use the folder right-click menu (Save Properties, Save Textures, ...) to line up exports — or check types below and queue a global export. Combining Properties/Textures/Models/Animations/Audio uses one load per asset. Nothing runs until you press Run." />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Queuing Mode" VerticalAlignment="Center"
                       ToolTip="While on, folder exports from the right-click menu are added to the queue below instead of running immediately" />
            <CheckBox x:Name="QueuingModeCheckBox" Grid.Row="0" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding IsQueuingMode, Mode=OneWay}" Click="OnQueuingModeClick"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Flat Archive Export" VerticalAlignment="Center"
                       ToolTip="When running the queue: put every loaded archive file into one flat list, export smallest→largest, and skip per-folder success console messages. On by default." />
            <CheckBox Grid.Row="2" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding FlatArchiveExport, Mode=TwoWay}"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Exclude .umap" VerticalAlignment="Center"
                       ToolTip="Skip .umap packages during Export Queue runs (flat or folder)." />
            <CheckBox Grid.Row="4" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding ExcludeUmap, Mode=TwoWay}"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Exclude Directories" VerticalAlignment="Center"
                       ToolTip="When enabled, skip packages under any folder path listed below during Export Queue runs. Paths are saved to the active profile." />
            <CheckBox Grid.Row="6" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding ExcludeDirectories, Mode=TwoWay}"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

            <TextBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" MinHeight="72" MaxHeight="120"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     IsEnabled="{Binding ExcludeDirectories}"
                     Text="{Binding IgnoredFolders, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Paste folder path prefixes to ignore (one per line, or comma/semicolon-separated). Examples: Engine/Content&#x0a;PioneerGame/Content/Maps. Matched against package paths." />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Exclude Classes" VerticalAlignment="Center"
                       ToolTip="When enabled, skip packages whose FMDex class tags match any entry below (during Export Queue runs). Unindexed packages are not skipped. Saved to the active profile." />
            <CheckBox Grid.Row="10" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding ExcludeClasses, Mode=TwoWay}"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />

            <TextBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" MinHeight="72" MaxHeight="120"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     IsEnabled="{Binding ExcludeClasses}"
                     Text="{Binding IgnoredClasses, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     ToolTip="Paste class names, fragments, or FMDex aliases (one per line). Examples: StaticMesh&#x0a;SkeletalMesh&#x0a;model&#x0a;tex&#x0a;Blueprint&#x0a;Niagara. Uses FMDex tags (substring + aliases like model/tex/anim)." />

            <TextBlock Grid.Row="14" Grid.Column="0" Text="Index Before Export" VerticalAlignment="Center"
                       ToolTip="When enabled, FMDex-indexes only the folders selected for this queue run before export starts (needed for class exclusion / tags). Does not index the whole archive. Flat Archive + 'All Loaded Assets' with no folder selection skips indexing." />
            <CheckBox Grid.Row="14" Grid.Column="2" Content="{Binding IsChecked, RelativeSource={RelativeSource Self}, Converter={x:Static converters:BoolToToggleConverter.Instance}}"
                      IsChecked="{Binding IndexBeforeExport, Mode=TwoWay}"
                      Style="{DynamicResource {x:Static adonisUi:Styles.ToggleSwitch}}" />
        </Grid>

        <Separator Grid.Row="3" Style="{StaticResource CustomSeparator}" Tag="ADD A GLOBAL EXPORT" />

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Orientation="Horizontal">
                <CheckBox Content="Properties (.json)" IsChecked="{Binding ExportProperties, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Textures" IsChecked="{Binding ExportTextures, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Models" IsChecked="{Binding ExportMeshes, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Animations" IsChecked="{Binding ExportAnimations, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Audio" IsChecked="{Binding ExportAudio, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Decompiled Code" IsChecked="{Binding ExportCode, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Raw Data" IsChecked="{Binding ExportRaw, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
                <CheckBox Content="Metadata" IsChecked="{Binding ExportMetadata, Mode=TwoWay}" Margin="0 0 12 4"
                          VerticalAlignment="Center" />
            </WrapPanel>
            <Button Grid.Row="2" HorizontalAlignment="Right" Content="Queue All Loaded Assets"
                    IsEnabled="{Binding HasSelectedBulkType}" Click="OnQueueGlobal" />
        </Grid>

        <Separator Grid.Row="5" Style="{StaticResource CustomSeparator}" Tag="QUEUE" />

        <Border Grid.Row="6" MaxHeight="260" BorderThickness="1" BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer2BorderBrush}}">
            <ListBox ItemsSource="{Binding Items}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     adonisExtensions:WatermarkExtension.Watermark="Nothing queued yet">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                            <Button Grid.Column="2" Content="✕" Padding="6 0" Click="OnRemoveItem" Tag="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Clear Queue" Click="OnClearQueue" />
            <Button Grid.Column="2" MinWidth="120" Content="Run Queue"
                    IsEnabled="{Binding HasItems}" Style="{DynamicResource {x:Static adonisUi:Styles.AccentButton}}" Click="OnRunQueue" />
        </Grid>
    </Grid>
</adonisControls:AdonisWindow>
